{
  "name": "earlstock-backend",
  "version": "0.1.0",
  "private": true,
  "description": "EarlStock backend API",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "OTEL_SERVICE_NAME=earlstock-api tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.observability.local --import ./telemetry/register.mjs src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/server.js",
    "import": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/importer/main.ts",
    "migrate:up": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/node-pg-migrate/bin/node-pg-migrate.js -d MIGRATION_DATABASE_URL up",
    "migrate:down": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/node-pg-migrate/bin/node-pg-migrate.js -d MIGRATION_DATABASE_URL down",
    "migrate:create": "node-pg-migrate create --migration-file-language sql",
    "db:provision": "docker compose -f ../docker-compose.yml run --rm postgres-provision",
    "db:setup": "docker compose -f ../docker-compose.yml up -d --wait postgres && npm run db:provision && npm run migrate:up",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@elastic/opentelemetry-node": "1.20.1",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
