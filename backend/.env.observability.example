# Optional observability settings (Elastic Distribution of OpenTelemetry, EDOT Node.js).
#
# Copy to `.env.observability.local` (ignored by Git) and fill in the values there. Telemetry is
# off whenever OTEL_EXPORTER_OTLP_ENDPOINT is empty or absent: the API and the importer then run
# exactly as without this file. Only `npm start` and `npm run import` read it; tests, migrations
# and database provisioning never do. Never put these values in frontend code or VITE_* variables.

# Elastic Cloud Serverless — Managed OTLP endpoint of the observability project (the normal OTLP
# endpoint, not a Supabase-specific one), e.g. https://<project>.ingest.<region>.<provider>.elastic.cloud:443
OTEL_EXPORTER_OTLP_ENDPOINT=

# API key created for that OTLP endpoint, in the form: Authorization=ApiKey <key>
# (an Elasticsearch REST API key or a Supabase-specific key is not a substitute).
OTEL_EXPORTER_OTLP_HEADERS=

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# service.name is NOT set here: each npm script sets OTEL_SERVICE_NAME for its own process
# (earlstock-api, earlstock-importer), and a value in this shared file would not override it.
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment.name=local

# Bounded export: losing telemetry is preferable to delaying the application.
# On exit, the API and the importer wait at most 3 s for telemetry (src/shared/telemetry.ts).
# Traces, metrics and logs are flushed in parallel, so every timeout below stays under that limit
# (2 s), leaving time for shutdown coordination and for the final log lines.
OTEL_EXPORTER_OTLP_TIMEOUT=2000
# Traces: batched every 5 s in a bounded queue (spans beyond it are dropped, not buffered).
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_EXPORT_TIMEOUT=2000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
# Metrics: exported every 60 s (the default); each export, including the final one, gives up after 2 s.
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_METRIC_EXPORT_TIMEOUT=2000
# Logs (only relevant if log records are exported later): same bound.
OTEL_BLRP_EXPORT_TIMEOUT=2000

# EDOT's own diagnostic output (default: info).
OTEL_LOG_LEVEL=warn

# ELASTIC_OTEL_NODE_ENABLE_LOG_SENDING is deliberately not set: EDOT only sends Pino, Bunyan and
# Winston records, and EarlStock uses its own JSON logger.
