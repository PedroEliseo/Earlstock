# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port the API listens on
PORT=3000

# PostgreSQL connection string (required): postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Matches the defaults of the postgres service in ../docker-compose.yml.
DATABASE_URL=postgres://earlstock:earlstock@localhost:5432/earlstock
# Maximum number of connections in the pool (1-100, default 10)
DATABASE_POOL_MAX=10

# Isolated database for the integration tests (tests/*.db.test.ts); they are skipped when unset.
# `npm test` DROPS AND RECREATES this database on every run, then applies all migrations.
# Its name MUST end in "_test" and differ from DATABASE_URL's — the test setup refuses otherwise.
TEST_DATABASE_URL=postgres://earlstock:earlstock@localhost:5432/earlstock_test

