# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port the API listens on
PORT=3000

# PostgreSQL connection string (required): postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Matches the defaults of the postgres service in ../docker-compose.yml.
DATABASE_URL=postgres://earlstock:earlstock@localhost:5432/earlstock
# Maximum number of connections in the pool (1-100, default 10)
DATABASE_POOL_MAX=10

# Isolated database for the integration tests (tests/*.db.test.ts); they are skipped when unset.
# `npm test` creates it if missing, migrates it, and truncates its tables between tests.
# Its name MUST end in "_test" — the test setup refuses to run against any other database.
TEST_DATABASE_URL=postgres://earlstock:earlstock@localhost:5432/earlstock_test

# Market data provider: "demo" (synthetic data, no API key, no external calls) or "eodhd".
MARKET_DATA_PROVIDER=demo
# EODHD API key — required only when MARKET_DATA_PROVIDER=eodhd. Set it in .env (never committed),
# e.g. EODHD_API_KEY=<your-eodhd-api-key>. Leave empty in demo mode.
EODHD_API_KEY=
# Maximum EODHD API calls per UTC day (default 15: the free plan's 20 minus a 5-call safety margin).
EODHD_DAILY_CALL_BUDGET=15
