# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port the API listens on
PORT=3000

# ---------------------------------------------------------------------------------------------------
# Database roles (see README, "Database roles"). The backend, migrations and administration each use
# their own connection; the backend never falls back to DATABASE_URL.
# ---------------------------------------------------------------------------------------------------

# ADMINISTRATIVE (superuser) connection: matches the postgres service in ../docker-compose.yml.
# Not used by the backend or by migrations; it identifies the development database for safety checks.
DATABASE_URL=postgres://earlstock:earlstock@localhost:5432/earlstock

# ADMINISTRATIVE (superuser) connection to the test database. `npm test` uses it ONLY to DROP AND
# RECREATE this database on every run; migrations and tests then run with the EarlStock roles.
# Its name MUST end in "_test" and differ from every other configured database.
TEST_DATABASE_URL=postgres://earlstock:earlstock@localhost:5432/earlstock_test

# Maximum number of connections in the backend's pool (1-100, default 10)
DATABASE_POOL_MAX=10

# Role credentials: put these three in backend/.env.local (git-ignored), which every npm script loads
# after .env and which `npm run db:provision` reads to create the roles: one source of truth.
# Use generated passwords containing only [A-Za-z0-9._~-] (e.g. `openssl rand -hex 24`).
#
# Schema-owner role: runs migrations only.
# MIGRATION_DATABASE_URL=postgres://earlstock_owner:<generated-password>@localhost:5432/earlstock
# Read-only API role: the only connection the backend uses (required).
# MARKET_DATA_DATABASE_URL=postgres://earlstock_api:<generated-password>@localhost:5432/earlstock
# Dataset importer role: the only connection `npm run import` uses (never the backend's).
# IMPORTER_DATABASE_URL=postgres://earlstock_importer:<generated-password>@localhost:5432/earlstock
